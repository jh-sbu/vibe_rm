; test-mod autotest25: swimming in two authored cells (a cell water level,
; placed still water), with steps of known depth and a ramp walked by
; TranslateTo, then a lake current measured outdoors. autotest25.rs
; documents the layout and what each reading predicts. The header
; (properties, marker arrays, the ramp's geometry) is generated by
; autotest25.rs. Cell water is at z 0 in both cells.

Bool Ran = false
ObjectReference StartMarker
Actor[] Fish
Int FishCount = 0

; The detector's state per subject, kept by Note (VrmAt25SwimLog's calls).
Bool PlayerSwim = false
Bool PlayerDry = false
Bool NpcSwim = false
Bool NpcDry = false
Float PlayerOne
Float PlayerTwo
Float NpcOne
Float NpcTwo
String EventLog = ""
Float MoveAt = 0.0
; While the ramp is walked, Note gives the bed's depth under the actor.
Bool Ramping = false
Float RampX0 = 0.0

Event OnInit()
    RegisterForSingleUpdate(10.0)
EndEvent

Event OnUpdate()
    If Ran
        return
    EndIf
    Ran = true
    FillMarkers()
    Fish = new Actor[32]
    Debug.Notification("vibe_rm autotest25 running: " + TestCount + " tests. Leave the game be.")
    StartMarker = Player.PlaceAtMe(XMarker, 1, true, false)
    Int n = 1
    While n <= TestCount
        String name = TestName(n)
        Debug.Notification("vibe_rm autotest25 " + n + "/" + TestCount + ": " + name)
        String r
        If SkipTest.GetValue() as Int == n
            r = "skipped by SkipTest\n"
        Else
            Float t = Now()
            r = RunTest(n)
            r += "(took " + Num(Now() - t) + " s)"
        EndIf
        Keep(n, r)
        Debug.Trace("vibe_rm autotest25 " + name + ": " + r)
        Game.RequestSave()
        Utility.Wait(3.0)
        n += 1
    EndWhile
    GoHome()
    Game.RequestSave()
    Utility.Wait(3.0)
    Debug.MessageBox("vibe_rm autotest25 done: read the reports with vrm-tool test-results.")
EndEvent

; Test n: 1-6 in the level-water cell, 7-12 in the placed-water cell, then
; the current.
String Function RunTest(Int n)
    If n > 12
        If n == 13
            return TestCurrent(Player)
        EndIf
        return TestCurrentNpc()
    EndIf
    Int c = (n - 1) / 6
    Int kind = (n - 1) % 6
    GoCell(c)
    If kind == 0
        return TestDry(c)
    ElseIf kind == 1
        return TestSteps(c, true)
    ElseIf kind == 2
        return TestSteps(c, false)
    ElseIf kind == 3
        return TestRamp(c)
    ElseIf kind == 4
        return TestNpc(c)
    EndIf
    return TestFloat(c)
EndFunction

; A float as text to one decimal.
String Function Num(Float f)
    String r = ""
    If f < 0.0
        r = "-"
        f = -f
    EndIf
    Int t = Math.Floor(f * 10.0 + 0.5)
    return r + (t / 10) + "." + (t % 10)
EndFunction

Float Function Now()
    return Utility.GetCurrentRealTime()
EndFunction

Function WaitUntil(Float t)
    Float left = t - Now()
    If left > 0.0
        Utility.Wait(left)
    EndIf
EndFunction

Function Gone(ObjectReference r)
    If r != None
        r.Disable(false)
        r.Delete()
    EndIf
EndFunction

; An NPC placed at m, x / y off it.
Actor Function SpawnAt(ObjectReference m, Float x, Float y)
    Actor a = Player.PlaceActorAtMe(SwimmerBase, 4, None)
    a.MoveTo(m, x, y, 0.0, true)
    return a
EndFunction

; The player to cell c's dry step, unless already in it.
Function GoCell(Int c)
    ObjectReference dry = Step(c, 0)
    If Player.GetParentCell() != dry.GetParentCell()
        Player.MoveTo(dry, 0.0, 0.0, 0.0, true)
        Utility.Wait(4.0)
    EndIf
EndFunction

; VrmAt25SwimLog's report: kind "swim" or "dry" started (on) or finished on a.
Function Note(Actor a, String kind, Bool on)
    String who = "n"
    If a == Player
        who = "p"
        If kind == "swim"
            PlayerSwim = on
        Else
            PlayerDry = on
        EndIf
    Else
        If kind == "swim"
            NpcSwim = on
        Else
            NpcDry = on
        EndIf
    EndIf
    String sign = "-"
    If on
        sign = "+"
    EndIf
    String s = " " + who + sign + kind + "@" + Num(Now() - MoveAt)
    If Ramping
        s += " bed " + Num(RampBed(a.GetPositionX())) + " z " + Num(a.GetPositionZ())
    EndIf
    EventLog += s
EndFunction

; The detector on a: the ability, its actor values read first.
Function Detect(Actor a)
    If a == Player
        If a.HasSpell(SwimAbility)
            return
        EndIf
        PlayerOne = a.GetActorValue("OneHanded")
        PlayerTwo = a.GetActorValue("TwoHanded")
    Else
        NpcOne = a.GetActorValue("OneHanded")
        NpcTwo = a.GetActorValue("TwoHanded")
    EndIf
    a.AddSpell(SwimAbility, false)
EndFunction

; The detector's reading on a: events ("S" swimming, "D" dry, "-" neither)
; and gains (OneHanded +10 swimming, TwoHanded +10 dry), then the feet's
; height against the surface (z 0 in the cells).
String Function State(Actor a)
    return Flags(a) + " z " + Num(a.GetPositionZ())
EndFunction

String Function Flags(Actor a)
    Bool swim = NpcSwim
    Bool dry = NpcDry
    Float one = a.GetActorValue("OneHanded") - NpcOne
    Float two = a.GetActorValue("TwoHanded") - NpcTwo
    If a == Player
        swim = PlayerSwim
        dry = PlayerDry
        one = a.GetActorValue("OneHanded") - PlayerOne
        two = a.GetActorValue("TwoHanded") - PlayerTwo
    EndIf
    return "ev " + Pair(swim, dry) + " av " + Pair(one > 5.0, two > 5.0)
EndFunction

String Function Pair(Bool swim, Bool dry)
    String s = "-"
    If swim
        s = "S"
    EndIf
    If dry
        return s + "D"
    EndIf
    return s + "-"
EndFunction

; 1, 7. The detector on the dry step (64 above the water): the player and
; an NPC 200 off, read 1 and 3 s after it is added (the player's only the
; first time; it stays on).
String Function TestDry(Int c)
    ObjectReference dry = Step(c, 0)
    Player.MoveTo(dry, 0.0, 0.0, 0.0, true)
    Actor npc = SpawnAt(dry, 200.0, 0.0)
    Utility.Wait(2.0)
    MoveAt = Now()
    EventLog = ""
    Detect(Player)
    Detect(npc)
    WaitUntil(MoveAt + 1.0)
    String r = "dry step, 1 s: player " + State(Player) + "; npc " + State(npc) + "\n"
    WaitUntil(MoveAt + 3.0)
    r += "3 s: player " + State(Player) + "; npc " + State(npc) + "\nevents:" + EventLog + "\n"
    npc.RemoveSpell(SwimAbility)
    Utility.Wait(0.5)
    Gone(npc)
    NpcSwim = false
    NpcDry = false
    return r
EndFunction

; a moved to marker m: the step's depth, then the detector 1 and 3 s
; later, and the effects' events since the move.
String Function SwimAt(Actor a, ObjectReference m)
    MoveAt = Now()
    EventLog = ""
    a.MoveTo(m, 0.0, 0.0, 0.0, true)
    String r = Num(-m.GetPositionZ()) + ":"
    WaitUntil(MoveAt + 1.0)
    r += " 1s " + State(a)
    WaitUntil(MoveAt + 3.0)
    r += "; 3s " + State(a)
    If a != Player
        r += " off " + Math.Floor(a.GetDistance(m))
    EndIf
    return r + " [" + EventLog + "]\n"
EndFunction

; 2, 3, 8, 9. The player to each step, shallow to deep (up) or back.
String Function TestSteps(Int c, Bool up)
    String r = "depth: 1s/3s events and gains (S swim, D dry), feet - surface [events since the move]\n"
    Int i = 1
    While i < StepCount
        Int k = i
        If !up
            k = StepCount - i
        EndIf
        r += SwimAt(Player, Step(c, k))
        i += 1
    EndWhile
    return r
EndFunction

; The bed's depth under the surface at x on the ramp's line: the deep pad
; before it, its stairs (the highest tread covering x), the dry pad after.
Float Function RampBed(Float x)
    Float u = x - RampX0 + RampHalfTread
    If u < 0.0
        return RampDeep
    EndIf
    Int j = Math.Floor(u / RampTread)
    If j >= RampTreads
        return -RampHigh
    EndIf
    return RampDeep - j * RampRise
EndFunction

; The tread line's height at x, a little above it.
Float Function RampLine(Float x)
    return -RampDeep + (x - RampX0 + RampHalfTread) * RampRise / RampTread + 3.0
EndFunction

; The player moved to (x, y, z) at RampSpeed, sampled every 4 s: the bed
; under it, its height and the detector.
String Function Walk(Float x, Float y, Float z)
    Float d = Math.Sqrt((x - Player.GetPositionX()) * (x - Player.GetPositionX()) + (z - Player.GetPositionZ()) * (z - Player.GetPositionZ()))
    Player.TranslateTo(x, y, z, 0.0, 0.0, Player.GetAngleZ(), RampSpeed, 0.0)
    Float t0 = Now()
    Float t = t0 + d / RampSpeed + 0.5
    String r = ""
    While Now() < t
        Utility.Wait(4.0)
        r += " [" + Num(Now() - MoveAt) + " bed " + Num(RampBed(Player.GetPositionX())) + " " + State(Player) + "]"
    EndWhile
    Player.StopTranslation()
    return r
EndFunction

; 4, 10. The ramp: from the dry pad down the stairs into the deep (in),
; then from floating over the deep end (feet 93 under) back up and out,
; moved by TranslateTo at RampSpeed. The detector's events give the bed's
; depth under the player when they came (the state lags a move by about
; 0.7 s in autotest20).
String Function TestRamp(Int c)
    ObjectReference deep = Ramp(c)
    RampX0 = deep.GetPositionX()
    Float y = deep.GetPositionY()
    Float top = RampX0 + RampTop
    Player.MoveTo(deep, RampTop + 300.0, 0.0, RampDeep + RampHigh, true)
    Utility.Wait(3.0)
    Ramping = true
    MoveAt = Now()
    EventLog = ""
    String r = "in, from " + State(Player) + " at bed " + Num(RampBed(Player.GetPositionX())) + ":"
    r += Walk(top, y, RampLine(top))
    r += Walk(RampX0 - RampHalfTread, y, RampLine(RampX0 - RampHalfTread))
    Utility.Wait(3.0)
    r += "\nthen " + State(Player) + "\nevents:" + EventLog + "\n"
    MoveAt = Now()
    EventLog = ""
    r += "out:"
    ; Held 93 under (autotest20's floating swimmers: 92.7 to 93.9) until
    ; the tread line comes up to that height, then along it.
    r += Walk(RampX0 - RampHalfTread, y, -93.0)
    Float level = RampX0 - RampHalfTread + (RampDeep - 96.0) * RampTread / RampRise
    r += Walk(level, y, -93.0)
    r += Walk(top, y, RampLine(top))
    r += Walk(top + 300.0, y, RampLine(top))
    Utility.Wait(3.0)
    r += "\nthen " + State(Player) + "\nevents:" + EventLog + "\n"
    Ramping = false
    return r
EndFunction

; 5, 11. An NPC to each step, shallow to deep, then back to the dry step,
; the player on the dry step.
String Function TestNpc(Int c)
    ObjectReference dry = Step(c, 0)
    Player.MoveTo(dry, -300.0, 0.0, 0.0, true)
    Actor npc = SpawnAt(dry, 0.0, 0.0)
    Utility.Wait(2.0)
    Detect(npc)
    Utility.Wait(2.0)
    String r = "depth: 1s/3s events and gains, feet - surface, off the marker [events]\n"
    Int i = 1
    While i < StepCount
        r += SwimAt(npc, Step(c, i))
        i += 1
    EndWhile
    r += "back: " + SwimAt(npc, dry)
    npc.RemoveSpell(SwimAbility)
    Gone(npc)
    NpcSwim = false
    NpcDry = false
    return r
EndFunction

; 6, 12. Whether a swimmer moved deep rises: the player to the deepest step,
; an NPC to the next, their feet's heights every second for 20 s.
String Function TestFloat(Int c)
    ObjectReference p = Step(c, StepCount - 1)
    ObjectReference q = Step(c, StepCount - 2)
    Actor npc = SpawnAt(Step(c, 0), 0.0, 0.0)
    Utility.Wait(1.0)
    Detect(npc)
    Utility.Wait(1.0)
    String r = "player at " + Num(-p.GetPositionZ()) + ", npc at " + Num(-q.GetPositionZ()) + "; t: player z / npc z\n"
    Float t0 = Now()
    Player.MoveTo(p, 0.0, 0.0, 0.0, true)
    npc.MoveTo(q, 0.0, 0.0, 0.0, true)
    Int i = 1
    While i <= 20
        WaitUntil(t0 + i)
        r += " " + i + ": " + Num(Player.GetPositionZ()) + " / " + Num(npc.GetPositionZ())
        If i % 5 == 0
            r += "\n"
        EndIf
        i += 1
    EndWhile
    r += "then player " + Flags(Player) + ", npc " + Flags(npc) + " off " + Math.Floor(npc.GetDistance(q)) + "\n"
    npc.RemoveSpell(SwimAbility)
    Gone(npc)
    NpcSwim = false
    NpcDry = false
    Player.MoveTo(Step(c, 0), 0.0, 0.0, 0.0, true)
    Utility.Wait(2.0)
    return r
EndFunction

; Disables the slaughterfish and anyone hostile to the player within 6000
; of at (enabled again by GoHome).
String Function ClearFish(ObjectReference at)
    Int found = 0
    Int i = 0
    While i < 80
        Actor a = Game.FindRandomActorFromRef(at, 6000.0)
        If a != None && a != Player && !a.IsDisabled() && (a.GetRace() == FishRace || a.IsHostileToActor(Player))
            a.Disable(false)
            If FishCount < 32
                Fish[FishCount] = a
                FishCount += 1
            EndIf
            found += 1
        EndIf
        i += 1
    EndWhile
    return "disabled " + found + " fish or hostiles nearby\n"
EndFunction

; The player to the current marker's spot, clearing it the first time.
String Function GoCurrent()
    ObjectReference m = Current(0)
    If Player.GetDistance(m) > 3000.0
        Player.MoveTo(m, 0.0, 0.0, 0.0, true)
        Utility.Wait(5.0)
        return ClearFish(m)
    EndIf
    return ""
EndFunction

; a's drift from m every second for 10 s: along the marker's heading,
; across it (right positive), and the feet against the surface.
String Function Drift(Actor a, ObjectReference m)
    a.MoveTo(m, 0.0, 0.0, 0.0, true)
    Float t0 = Now()
    String r = ""
    Int i = 1
    While i <= 10
        WaitUntil(t0 + i)
        Float dx = a.GetPositionX() - m.GetPositionX()
        Float dy = a.GetPositionY() - m.GetPositionY()
        Float along = dx * Math.Sin(CurrentHeading) + dy * Math.Cos(CurrentHeading)
        Float across = dx * Math.Cos(CurrentHeading) - dy * Math.Sin(CurrentHeading)
        r += " " + i + ": " + Num(along) + ", " + Num(across) + ", " + Num(a.GetPositionZ() - CurrentSurface)
        If i % 5 == 0
            r += "\n"
        EndIf
        i += 1
    EndWhile
    return r
EndFunction

; 13. The player left still at each point by the current marker.
String Function TestCurrent(Actor a)
    String r = GoCurrent()
    r += "surface " + Num(CurrentSurface) + ", heading " + Num(CurrentHeading) + "; t: along, across, feet - surface\n"
    Int i = 0
    While i < CurrentCount
        r += CurrentLabel(i) + " (bed " + Num(CurrentDepth(i)) + " deep):\n" + Drift(a, Current(i))
        i += 1
    EndWhile
    return r
EndFunction

; 14. An NPC the same way, the player waiting by the marker.
String Function TestCurrentNpc()
    String r = GoCurrent()
    Actor npc = SpawnAt(Current(0), 0.0, 0.0)
    Utility.Wait(1.0)
    r += "t: along, across, feet - surface; the player off the marker at the end\n"
    Int i = 0
    While i < CurrentCount
        Player.MoveTo(Current(0), 0.0, -300.0, 0.0, true)
        r += CurrentLabel(i) + ":\n" + Drift(npc, Current(i))
        i += 1
    EndWhile
    r += "player " + Math.Floor(Player.GetDistance(Current(0))) + "\n"
    Gone(npc)
    return r
EndFunction

Function GoHome()
    Int i = 0
    While i < FishCount
        Fish[i].Enable(false)
        i += 1
    EndWhile
    Player.RemoveSpell(SwimAbility)
    Player.MoveTo(StartMarker, 0.0, 0.0, 0.0, true)
    Utility.Wait(3.0)
EndFunction
