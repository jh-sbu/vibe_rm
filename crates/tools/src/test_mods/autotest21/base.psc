; The helpers every test uses. The header (Scriptname, properties, the
; Result variables and the runner) is generated by autotest21.rs.

; A float as text to three decimals, without them when whole.
String Function Num(Float f)
    String r = ""
    If f < 0.0
        r = "-"
        f = -f
    EndIf
    Int t = Math.Floor(f * 1000.0 + 0.5)
    Int whole = t / 1000
    Int frac = t % 1000
    r = r + whole
    If frac == 0
        return r
    EndIf
    r += "."
    If frac < 100
        r += "0"
    EndIf
    If frac < 10
        r += "0"
    EndIf
    return r + frac
EndFunction

; A form as text: its form id in hex-ish decimal, or "none".
String Function Id(Form f)
    If f == None
        return "none"
    EndIf
    return "#" + f.GetFormID()
EndFunction

Float Function Now()
    return Utility.GetCurrentRealTime()
EndFunction

; An actor of base b placed in the test cell, x / y from its centre.
Actor Function Spawn(ActorBase b, Float x, Float y)
    Actor a = CellCenter.PlaceActorAtMe(b, 4, None)
    a.MoveTo(CellCenter, x, y, 0.0, false)
    return a
EndFunction

; The same in the warehouse.
Actor Function SpawnWh(ActorBase b, Float x, Float y)
    Actor a = WhCenter.PlaceActorAtMe(b, 4, None)
    a.MoveTo(WhCenter, x, y, 0.0, false)
    return a
EndFunction

; An object placed in the test cell.
ObjectReference Function Put(Form f, Float x, Float y, Float z)
    ObjectReference o = CellCenter.PlaceAtMe(f, 1, false, false)
    o.MoveTo(CellCenter, x, y, z, false)
    return o
EndFunction

Function Gone(ObjectReference r)
    If r != None
        r.Disable(false)
        r.Delete()
    EndIf
EndFunction

; Whether probe spell s (its effect e) holds on a: the effect's condition
; read both by HasMagicEffect and by the +3 OneHanded it gives.
String Function Probe(Actor a, Spell s, MagicEffect e)
    Float before = a.GetActorValue("OneHanded")
    a.AddSpell(s, false)
    Utility.Wait(2.0)
    Bool has = a.HasMagicEffect(e)
    Float gain = a.GetActorValue("OneHanded") - before
    a.RemoveSpell(s)
    Utility.Wait(0.5)
    If has && gain > 2.5
        return "yes"
    ElseIf !has && gain < 0.5
        return "no"
    EndIf
    return "(has " + has + ", +" + gain + ")"
EndFunction

Function GoCell()
    Player.MoveTo(CellEntry, 0.0, 0.0, 0.0, true)
    Utility.Wait(3.0)
EndFunction

Function GoWarehouse()
    Player.MoveTo(WhEntry, 0.0, 0.0, 0.0, true)
    Utility.Wait(4.0)
EndFunction

; Health lost by a over a call's worth of seconds.
Float Function Health(Actor a)
    return a.GetActorValue("Health")
EndFunction

; Waits up to t seconds for a to be in combat (state 1); the seconds taken,
; or -1.
Float Function UntilCombat(Actor a, Float t)
    Float start = Now()
    While Now() - start < t
        If a.GetCombatState() == 1
            return Now() - start
        EndIf
        Utility.Wait(0.25)
    EndWhile
    return -1.0
EndFunction

; Two actors made to fight, both held in place, in the warehouse.
Function Fight(Actor a, Actor b)
    a.StartCombat(b)
    b.StartCombat(a)
EndFunction
