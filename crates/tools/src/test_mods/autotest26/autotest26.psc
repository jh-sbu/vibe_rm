; test-mod autotest26: a lake's current, measured on a still player and a
; still NPC at points around a water current marker (autotest25's current
; tests, whose MoveTo to the markers did nothing). Each move is checked and
; reported, with a way round by dry land. autotest26.rs documents it; the
; header (properties, marker arrays) is generated by autotest26.rs.

Bool Ran = false
ObjectReference StartMarker
Actor[] Fish
Int FishCount = 0

Event OnInit()
    RegisterForSingleUpdate(10.0)
EndEvent

Event OnUpdate()
    If Ran
        return
    EndIf
    Ran = true
    FillMarkers()
    Fish = new Actor[32]
    Debug.Notification("vibe_rm autotest26 running: 2 tests. Leave the game be.")
    StartMarker = Player.PlaceAtMe(XMarker, 1, true, false)
    Debug.Notification("vibe_rm autotest26 1/2: CurrentPlayer")
    If SkipTest.GetValue() as Int == 1
        ResultCurrentPlayer = "skipped by SkipTest\n"
    Else
        Float t = Now()
        ResultCurrentPlayer = TestCurrentPlayer() + "(took " + Num(Now() - t) + " s)"
    EndIf
    Debug.Trace("vibe_rm autotest26 CurrentPlayer: " + ResultCurrentPlayer)
    Game.RequestSave()
    Utility.Wait(3.0)
    Debug.Notification("vibe_rm autotest26 2/2: CurrentNpc")
    If SkipTest.GetValue() as Int == 2
        ResultCurrentNpc = "skipped by SkipTest\n"
    Else
        Float t = Now()
        ResultCurrentNpc = TestCurrentNpc() + "(took " + Num(Now() - t) + " s)"
    EndIf
    Debug.Trace("vibe_rm autotest26 CurrentNpc: " + ResultCurrentNpc)
    Game.RequestSave()
    Utility.Wait(3.0)
    GoHome()
    Game.RequestSave()
    Utility.Wait(3.0)
    Debug.MessageBox("vibe_rm autotest26 done: read the reports with vrm-tool test-results.")
EndEvent

; A float as text to one decimal.
String Function Num(Float f)
    String r = ""
    If f < 0.0
        r = "-"
        f = -f
    EndIf
    Int t = Math.Floor(f * 10.0 + 0.5)
    return r + (t / 10) + "." + (t % 10)
EndFunction

Float Function Now()
    return Utility.GetCurrentRealTime()
EndFunction

Function WaitUntil(Float t)
    Float left = t - Now()
    If left > 0.0
        Utility.Wait(left)
    EndIf
EndFunction

String Function Id(Form f)
    If f == None
        return "none"
    EndIf
    return "#" + f.GetFormID()
EndFunction

; Where r is: its worldspace, cell and position.
String Function Where(ObjectReference r)
    return "world " + Id(r.GetWorldSpace()) + " cell " + Id(r.GetParentCell()) + " at " + Num(r.GetPositionX()) + ", " + Num(r.GetPositionY()) + ", " + Num(r.GetPositionZ())
EndFunction

; Whether a is within 300 of m in m's worldspace.
Bool Function Near(ObjectReference a, ObjectReference m)
    If a.GetWorldSpace() != m.GetWorldSpace()
        return false
    EndIf
    Float d = a.GetDistance(m)
    return d >= 0.0 && d < 300.0
EndFunction

; The player to m: directly, then if that fails by the dry-land marker.
; Each try is reported.
String Function Reach(ObjectReference m)
    String r = "target: " + Where(m) + "\nplayer: " + Where(Player) + "\n"
    Player.MoveTo(m, 0.0, 0.0, 0.0, true)
    Utility.Wait(5.0)
    r += "MoveTo the target: " + Where(Player) + "\n"
    If Near(Player, m)
        return r
    EndIf
    Player.MoveTo(Shore, 0.0, 0.0, 0.0, true)
    Utility.Wait(5.0)
    r += "MoveTo the shore marker: " + Where(Player) + "\n"
    Player.MoveTo(m, 0.0, 0.0, 0.0, true)
    Utility.Wait(3.0)
    r += "then the target: " + Where(Player) + "\n"
    If !Near(Player, m)
        r += "not reached\n"
    EndIf
    return r
EndFunction

; Disables the slaughterfish and anyone hostile to the player within 6000
; of at (enabled again by GoHome).
String Function ClearFish(ObjectReference at)
    Int found = 0
    Int i = 0
    While i < 80
        Actor a = Game.FindRandomActorFromRef(at, 6000.0)
        If a != None && a != Player && !a.IsDisabled() && (a.GetRace() == FishRace || a.IsHostileToActor(Player))
            a.Disable(false)
            If FishCount < 32
                Fish[FishCount] = a
                FishCount += 1
            EndIf
            found += 1
        EndIf
        i += 1
    EndWhile
    return "disabled " + found + " fish or hostiles nearby\n"
EndFunction

; a's drift from m every second for 10 s: along the marker's heading,
; across it (right positive), and the feet against the surface. a is
; moved to m first; a line says so if it didn't get there.
String Function Drift(Actor a, ObjectReference m)
    a.MoveTo(m, 0.0, 0.0, 0.0, true)
    Float t0 = Now()
    String r = ""
    Int i = 1
    While i <= 10
        WaitUntil(t0 + i)
        Float dx = a.GetPositionX() - m.GetPositionX()
        Float dy = a.GetPositionY() - m.GetPositionY()
        Float along = dx * Math.Sin(CurrentHeading) + dy * Math.Cos(CurrentHeading)
        Float across = dx * Math.Cos(CurrentHeading) - dy * Math.Sin(CurrentHeading)
        r += " " + i + ": " + Num(along) + ", " + Num(across) + ", " + Num(a.GetPositionZ() - CurrentSurface)
        If i % 5 == 0
            r += "\n"
        EndIf
        i += 1
    EndWhile
    If a.GetWorldSpace() != m.GetWorldSpace()
        r += "(not in the marker's worldspace: " + Where(a) + ")\n"
    EndIf
    return r
EndFunction

; 1. The player left still at each point by the current marker.
String Function TestCurrentPlayer()
    String r = Reach(Current(0))
    r += ClearFish(Current(0))
    r += "surface " + Num(CurrentSurface) + ", heading " + Num(CurrentHeading) + "; t: along, across, feet - surface\n"
    Int i = 0
    While i < CurrentCount
        r += CurrentLabel(i) + " (bed " + Num(CurrentDepth(i)) + " deep):\n" + Drift(Player, Current(i))
        i += 1
    EndWhile
    return r
EndFunction

; 2. An NPC the same way, the player waiting 300 off the marker.
String Function TestCurrentNpc()
    String r = ""
    If !Near(Player, Current(0)) && Player.GetDistance(Current(0)) > 3000.0
        r += Reach(Current(0))
    EndIf
    Actor npc = Player.PlaceActorAtMe(SwimmerBase, 4, None)
    Utility.Wait(1.0)
    r += "t: along, across, feet - surface\n"
    Int i = 0
    While i < CurrentCount
        Player.MoveTo(Current(0), 0.0, -300.0, 0.0, true)
        r += CurrentLabel(i) + ":\n" + Drift(npc, Current(i))
        i += 1
    EndWhile
    npc.Disable(false)
    npc.Delete()
    return r
EndFunction

Function GoHome()
    Int i = 0
    While i < FishCount
        Fish[i].Enable(false)
        i += 1
    EndWhile
    Player.MoveTo(StartMarker, 0.0, 0.0, 0.0, true)
    Utility.Wait(3.0)
EndFunction
