; test-mod autotest20: when an actor swims (by depth, going in and coming
; back out, with Waterbreathing, an NPC) and whether a fighter that already
; knows its target sprints to close 1500 or 2500 units. autotest20.rs
; documents the readings and what each predicts. The header (properties,
; the marker array) is generated by autotest20.rs.

Bool Ran = false
ObjectReference StartMarker
Actor[] Fish
Int FishCount = 0

; The detector's state per subject, kept by Note (VrmAt20SwimLog's calls).
Bool PlayerSwim = false
Bool PlayerDry = false
Bool NpcSwim = false
Bool NpcDry = false
; Each subject's OneHanded and TwoHanded before the detector was added.
Float PlayerOne
Float PlayerTwo
Float NpcOne
Float NpcTwo
Actor Swimmer
String EventLog = ""
Float MoveAt = 0.0

String ResultDry
String ResultCharge1500
String ResultCharge2500
String ResultSwimUp
String ResultSwimDown
String ResultSwimNpc
String ResultSwimBreathing

Event OnInit()
    RegisterForSingleUpdate(10.0)
EndEvent

Event OnUpdate()
    If Ran
        return
    EndIf
    Ran = true
    FillMarkers()
    Fish = new Actor[32]
    Debug.Notification("vibe_rm autotest20 running: 7 tests. Leave the game be.")
    StartMarker = Player.PlaceAtMe(XMarker, 1, true, false)
    If Skip(1, "Dry")
        ResultDry = "skipped by SkipTest\n"
    Else
        ResultDry = Timed(1)
    EndIf
    Checkpoint("Dry", ResultDry)
    If Skip(2, "Charge1500")
        ResultCharge1500 = "skipped by SkipTest\n"
    Else
        ResultCharge1500 = Timed(2)
    EndIf
    Checkpoint("Charge1500", ResultCharge1500)
    If Skip(3, "Charge2500")
        ResultCharge2500 = "skipped by SkipTest\n"
    Else
        ResultCharge2500 = Timed(3)
    EndIf
    Checkpoint("Charge2500", ResultCharge2500)
    If Skip(4, "SwimUp")
        ResultSwimUp = "skipped by SkipTest\n"
    Else
        ResultSwimUp = Timed(4)
    EndIf
    Checkpoint("SwimUp", ResultSwimUp)
    If Skip(5, "SwimDown")
        ResultSwimDown = "skipped by SkipTest\n"
    Else
        ResultSwimDown = Timed(5)
    EndIf
    Checkpoint("SwimDown", ResultSwimDown)
    If Skip(6, "SwimNpc")
        ResultSwimNpc = "skipped by SkipTest\n"
    Else
        ResultSwimNpc = Timed(6)
    EndIf
    Checkpoint("SwimNpc", ResultSwimNpc)
    If Skip(7, "SwimBreathing")
        ResultSwimBreathing = "skipped by SkipTest\n"
    Else
        ResultSwimBreathing = Timed(7)
    EndIf
    Checkpoint("SwimBreathing", ResultSwimBreathing)
    GoHome()
    Game.RequestSave()
    Utility.Wait(3.0)
    Debug.MessageBox("vibe_rm autotest20 done: read the reports with vrm-tool test-results.")
EndEvent

Bool Function Skip(Int n, String name)
    Debug.Notification("vibe_rm autotest20 " + n + "/7: " + name)
    return SkipTest.GetValue() as Int == n
EndFunction

Function Checkpoint(String name, String result)
    Debug.Trace("vibe_rm autotest20 " + name + ": " + result)
    Game.RequestSave()
    Utility.Wait(3.0)
EndFunction

; Test n, with the seconds it took.
String Function Timed(Int n)
    Float t = Now()
    String r
    If n == 1
        r = TestDry()
    ElseIf n == 2
        r = TestCharge(1500.0)
    ElseIf n == 3
        r = TestCharge(2500.0)
    ElseIf n == 4
        r = TestSwim(Player, true, false)
    ElseIf n == 5
        r = TestSwim(Player, false, false)
    ElseIf n == 6
        r = TestSwimNpc()
    Else
        r = TestSwim(Player, true, true)
    EndIf
    return r + "(took " + Num(Now() - t) + " s)"
EndFunction

; A float as text to one decimal.
String Function Num(Float f)
    String r = ""
    If f < 0.0
        r = "-"
        f = -f
    EndIf
    Int t = Math.Floor(f * 10.0 + 0.5)
    return r + (t / 10) + "." + (t % 10)
EndFunction

Float Function Now()
    return Utility.GetCurrentRealTime()
EndFunction

Function WaitUntil(Float t)
    Float left = t - Now()
    If left > 0.0
        Utility.Wait(left)
    EndIf
EndFunction

; An actor of base b placed x / y from the player (world axes).
Actor Function Spawn(ActorBase b, Float x, Float y)
    Actor a = Player.PlaceActorAtMe(b, 4, None)
    a.MoveTo(Player, x, y, 0.0, false)
    return a
EndFunction

Function Gone(ObjectReference r)
    If r != None
        r.Disable(false)
        r.Delete()
    EndIf
EndFunction

Function Tough(Actor a)
    a.ModActorValue("Health", 1000.0)
    a.RestoreActorValue("Health", 2000.0)
EndFunction

; VrmAt20SwimLog's report: kind "swim" or "dry" started (on) or finished on a.
Function Note(Actor a, String kind, Bool on)
    String who = "n"
    If a == Player
        who = "p"
        If kind == "swim"
            PlayerSwim = on
        Else
            PlayerDry = on
        EndIf
    Else
        If kind == "swim"
            NpcSwim = on
        Else
            NpcDry = on
        EndIf
    EndIf
    String sign = "-"
    If on
        sign = "+"
    EndIf
    EventLog += " " + who + sign + kind + "@" + Num(Now() - MoveAt)
EndFunction

; The detector on a: the ability, its actor values read first.
Function Detect(Actor a)
    If a == Player
        PlayerOne = a.GetActorValue("OneHanded")
        PlayerTwo = a.GetActorValue("TwoHanded")
    Else
        NpcOne = a.GetActorValue("OneHanded")
        NpcTwo = a.GetActorValue("TwoHanded")
    EndIf
    a.AddSpell(SwimAbility, false)
EndFunction

; The detector's reading on a: the effects' events ("S" swimming, "D"
; dry, "-" neither) and their gains (OneHanded +10 swimming, TwoHanded +10
; dry), then the feet against the surface.
String Function State(Actor a)
    Bool swim = NpcSwim
    Bool dry = NpcDry
    Float one = a.GetActorValue("OneHanded") - NpcOne
    Float two = a.GetActorValue("TwoHanded") - NpcTwo
    If a == Player
        swim = PlayerSwim
        dry = PlayerDry
        one = a.GetActorValue("OneHanded") - PlayerOne
        two = a.GetActorValue("TwoHanded") - PlayerTwo
    EndIf
    return "ev " + Flags(swim, dry) + " av " + Flags(one > 5.0, two > 5.0) + " z " + Num(a.GetPositionZ() - Surface)
EndFunction

String Function Flags(Bool swim, Bool dry)
    String s = "-"
    If swim
        s = "S"
    EndIf
    If dry
        return s + "D"
    EndIf
    return s + "-"
EndFunction

; 1. The detector on land, where the run began: the player and an NPC 200
; off, read 1 and 3 s after it is added.
String Function TestDry()
    Actor npc = Spawn(SwimmerBase, 200.0, 0.0)
    Utility.Wait(2.0)
    MoveAt = Now()
    EventLog = ""
    Detect(Player)
    Detect(npc)
    WaitUntil(MoveAt + 1.0)
    String r = "on land, 1 s: player " + State(Player) + "; npc " + State(npc) + "\n"
    WaitUntil(MoveAt + 3.0)
    r += "3 s: player " + State(Player) + "; npc " + State(npc) + "\nevents:" + EventLog + "\n"
    npc.RemoveSpell(SwimAbility)
    Utility.Wait(0.5)
    Gone(npc)
    NpcSwim = false
    NpcDry = false
    return r
EndFunction

; a's distance to b and its gait (S sprinting, R running, W neither) every
; 0.25 s, four samples a line with the time first, until a is within near
; or seconds pass.
String Function Chase(Actor a, Actor b, Float seconds, Float near)
    String r = ""
    Float t0 = Now()
    Int i = 0
    While Now() - t0 < seconds
        If i % 4 == 0
            r += Num(Now() - t0) + ":"
        EndIf
        Float d = a.GetDistance(b)
        r += " " + Math.Floor(d)
        If a.IsSprinting()
            r += " S"
        ElseIf a.IsRunning()
            r += " R"
        Else
            r += " W"
        EndIf
        i += 1
        If i % 4 == 0
            r += "\n"
        EndIf
        If d < near
            t0 = -1000.0
        Else
            Utility.Wait(0.25)
        EndIf
    EndWhile
    If i % 4 != 0
        r += "\n"
    EndIf
    return r
EndFunction

; 2, 3. A fighter in combat with a held target 300 off; once it has engaged
; (or after 8 s) the target is moved `far` past it along the same line.
String Function TestCharge(Float far)
    Actor fighter = Spawn(FighterBase, 250.0, 0.0)
    Actor target = Spawn(TargetBase, 550.0, 0.0)
    fighter.AddItem(Sword, 1, true)
    fighter.EquipItem(Sword, false, true)
    Tough(fighter)
    Tough(target)
    target.SetRestrained(true)
    Utility.Wait(1.5)
    fighter.StartCombat(target)
    Float t0 = Now()
    While Now() - t0 < 8.0 && (fighter.GetCombatState() != 1 || fighter.GetDistance(target) > 200.0)
        Utility.Wait(0.25)
    EndWhile
    String r = "engaged after " + Num(Now() - t0) + " s at " + Math.Floor(fighter.GetDistance(target)) + ", combat state " + fighter.GetCombatState() + ", drawn " + fighter.IsWeaponDrawn() + ", stamina " + Num(fighter.GetActorValue("Stamina")) + "\n"
    Float dx = target.GetPositionX() - fighter.GetPositionX()
    Float dy = target.GetPositionY() - fighter.GetPositionY()
    Float len = Math.Sqrt(dx * dx + dy * dy)
    If len < 1.0
        dx = 1.0
        dy = 0.0
        len = 1.0
    EndIf
    target.MoveTo(fighter, dx / len * far, dy / len * far, 0.0, false)
    Utility.Wait(0.2)
    r += "target moved: " + Math.Floor(fighter.GetDistance(target)) + " off, its height against the fighter's " + Num(target.GetPositionZ() - fighter.GetPositionZ()) + "\n"
    r += Chase(fighter, target, 14.0, 200.0)
    r += "then combat state " + fighter.GetCombatState() + ", stamina " + Num(fighter.GetActorValue("Stamina")) + ", target health " + Num(target.GetActorValue("Health")) + "\n"
    Gone(fighter)
    Gone(target)
    Utility.Wait(1.0)
    return r
EndFunction

; Disables the slaughterfish and anyone hostile to the player within 6000
; of at (enabled again by GoHome).
String Function ClearFish(ObjectReference at)
    Int found = 0
    Int i = 0
    While i < 80
        Actor a = Game.FindRandomActorFromRef(at, 6000.0)
        If a != None && a != Player && !a.IsDisabled() && (a.GetRace() == FishRace || a.IsHostileToActor(Player))
            a.Disable(false)
            If FishCount < 32
                Fish[FishCount] = a
                FishCount += 1
            EndIf
            found += 1
        EndIf
        i += 1
    EndWhile
    return "disabled " + found + " fish or hostiles nearby\n"
EndFunction

; The player to the shore (the shallowest marker), clearing it first.
String Function GoShore()
    String r = ""
    If Player.GetDistance(Markers[0]) > 500.0
        Player.MoveTo(Markers[0], 0.0, 0.0, 0.0, true)
        Utility.Wait(5.0)
        r = "surface " + Num(Surface) + "; " + ClearFish(Markers[0])
    EndIf
    return r
EndFunction

Function GoHome()
    Int i = 0
    While i < FishCount
        Fish[i].Enable(false)
        i += 1
    EndWhile
    Player.RemoveSpell(SwimAbility)
    Player.RemoveSpell(Waterbreathing)
    Player.MoveTo(StartMarker, 0.0, 0.0, 0.0, true)
    Utility.Wait(3.0)
EndFunction

; a moved to marker m: the bed's depth there, then the detector 1 and 3 s
; later, and the effects' events since the move.
String Function SwimAt(Actor a, ObjectReference m)
    MoveAt = Now()
    EventLog = ""
    a.MoveTo(m, 0.0, 0.0, 0.0, true)
    String r = Num(Surface - m.GetPositionZ()) + ":"
    WaitUntil(MoveAt + 1.0)
    r += " 1s " + State(a)
    WaitUntil(MoveAt + 3.0)
    r += "; 3s " + State(a)
    If a != Player
        r += " off " + Math.Floor(a.GetDistance(m))
    EndIf
    return r + " [" + EventLog + "]\n"
EndFunction

; 4, 5, 7. The swimmer to each marker, shallow to deep (up) or back.
String Function TestSwim(Actor a, Bool up, Bool breathing)
    String r = GoShore()
    If breathing
        a.AddSpell(Waterbreathing, false)
        Utility.Wait(1.0)
    EndIf
    If !a.HasSpell(SwimAbility)
        Detect(a)
        Utility.Wait(2.0)
    EndIf
    r += "depth: 1s/3s events and gains (S swim, D dry), feet - surface [events since the move]\n"
    Int n = Markers.Length
    Int i = 0
    While i < n
        Int k = i
        If !up
            k = n - 1 - i
        EndIf
        r += SwimAt(a, Markers[k])
        i += 1
    EndWhile
    If breathing
        a.RemoveSpell(Waterbreathing)
    EndIf
    return r
EndFunction

; 6. An NPC to each marker, shallow to deep then back to the shallowest,
; the player waiting on the shore.
String Function TestSwimNpc()
    String r = GoShore()
    Player.MoveTo(Markers[0], 0.0, 0.0, 0.0, true)
    Utility.Wait(2.0)
    Swimmer = Player.PlaceActorAtMe(SwimmerBase, 4, None)
    Swimmer.MoveTo(Markers[0], 0.0, 0.0, 0.0, true)
    Utility.Wait(2.0)
    Detect(Swimmer)
    Utility.Wait(2.0)
    r += "depth: 1s/3s events and gains, feet - surface, off the marker [events]\n"
    Int i = 0
    While i < Markers.Length
        r += SwimAt(Swimmer, Markers[i])
        i += 1
    EndWhile
    r += "back: " + SwimAt(Swimmer, Markers[0])
    Swimmer.RemoveSpell(SwimAbility)
    Gone(Swimmer)
    NpcSwim = false
    NpcDry = false
    return r
EndFunction
